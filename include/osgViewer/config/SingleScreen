 * Viewer configuration that creates a fullscreen window on one screen.
 * Used for immersive or presentation-style rendering.
 */
#pragma once

#include <osg/core/Inherit.hpp>
#include <osgViewer/core/View.hpp>

namespace osgViewer {

/** single camera associated with a single full screen GraphicsWindow.*/
class OSGVIEWER_EXPORT SingleScreen : public osg::Inherit<ViewConfig, SingleScreen>
{
    public:
        
        SingleScreen(unsigned int screenNum=0) : _screenNum(screenNum) {}
        SingleScreen(const SingleScreen& rhs, const osg::CopyOp& copyop=osg::CopyOp::SHALLOW_COPY) : Inherit(rhs,copyop), _screenNum(rhs._screenNum) {}
        
        OSG_REGISTER_TYPE(osgViewer, SingleScreen)
        
        virtual void configure(osgViewer::View& view) const;

        void setScreenNum(unsigned int sn) { _screenNum = sn; }
        unsigned int getScreenNum() const { return _screenNum; }
        
    protected:
        
        unsigned int _screenNum;
};

}
