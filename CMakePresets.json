{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BUILD_OSG_EXAMPLES": "ON"
            }
        },
        {
            "name": "iwyu",
            "inherits": "default",
            "cacheVariables": {
                "WITH_IWYU": "ON"
            }
        },
        {
            "name": "gcc",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "BUILD_OSG_EXAMPLES": "ON"
            }
        },
        {
            "name": "build",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "ENABLE_SANITIZERS": "OFF",
                "ENABLE_COVERAGE": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TIDY": "OFF"
            }
        },
        {
            "name": "tsan",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-tsan",
            "cacheVariables": {
                "THREAD_SANITIZE": "ON",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TIDY": "OFF"
            }
        },
        {
            "name": "msan",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-msan",
            "cacheVariables": {
                "MEMORY_SANITIZE": "ON",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TIDY": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release — no sanitizers, no coverage, no tidy",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "ENABLE_SANITIZERS": "OFF",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TIDY": "OFF",
                "ENABLE_PERF": "OFF",
                "ENABLE_VALGRIND": "OFF",
                "ENABLE_HEAPTRACK": "OFF",
                "BUILD_OSG_EXAMPLES": "ON",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "profile",
            "displayName": "Profiling — RelWithDebInfo + frame pointers, uninstrumented",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build-profile",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer",
                "CMAKE_C_FLAGS": "-fno-omit-frame-pointer"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug — sanitizers on, coverage off, tidy off",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TIDY": "OFF",
                "BUILD_TESTING": "ON"
            }
        }
    ]
}
